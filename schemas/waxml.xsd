<?xml version="1.0"?>
<xs:schema 
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="https://www.w3schools.com"
  xmlns="https://www.w3schools.com"
  elementFormDefault="qualified">

  


  <!-- Types -->

  <xs:simpleType name="version">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="volume">
    <xs:annotation>
      <xs:documentation>Overall volume level. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="volumeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="volumeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="mathExpression">
    <xs:annotation>
      <xs:documentation>A mathematical expression containing at least one variable reference ($name), e.g. "$a", "$a + $b", "2 * $a - 1", "($a + $b) * 0.5". The variable does not need to be the first term - plain numbers and parentheses can appear before, after, or around it. At least one variable must be present somewhere, otherwise the value would be ambiguous with this attribute's own plain numeric range. Parentheses are accepted syntactically but their balance is not verified by this schema (regular expressions cannot express that) - full expression correctness (balanced parens, operator precedence, etc.) is validated at runtime by the WAXML expression parser, not by XSD.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(\(*\s*(\$[a-zA-Z_][a-zA-Z0-9_]*|\d+(\.\d+)?)\s*\)*\s*[+\-*/]\s*)*\(*\s*\$[a-zA-Z_][a-zA-Z0-9_]*\s*\)*(\s*[+\-*/]\s*\(*\s*(\$[a-zA-Z_][a-zA-Z0-9_]*|\d+(\.\d+)?)\s*\)*)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="gain">
    <xs:annotation>
      <xs:documentation>Gain/volume level. Three accepted forms: a unitless ratio in the range 0-1; a decibel value suffixed with "dB" (e.g. "-40dB") - this form works standalone, no variable required; or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="gainValue gainDecibel mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="gainValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="gainDecibel">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d+(\.\d+)?dB"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="convolution">
    <xs:annotation>
      <xs:documentation>Path or URL to an impulse response audio file used for convolution. Accepts either a relative path (letters, digits, underscore, hyphen, slash, dot) or an absolute URL (http:// or https://).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="https?://[^\s]+|[a-zA-Z0-9_\-./]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="convolutionGain">
    <xs:annotation>
      <xs:documentation>Gain applied to the portion of the signal sent to a convolution reverb, used by AmbientAudio and ObjectBasedAudio (not by ConvolverNode itself). Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="convolutionGainValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="convolutionGainValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="normalize">
    <xs:annotation>
      <xs:documentation>Whether to normalize the audio. Either a boolean value (true/false), or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="normalizeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="normalizeValue">
    <xs:restriction base="xs:boolean"/>
  </xs:simpleType>

  <xs:simpleType name="loop">
    <xs:annotation>
      <xs:documentation>Whether to loop playback. Either a boolean value (true/false), or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="loopValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="loopValue">
    <xs:restriction base="xs:boolean"/>
  </xs:simpleType>


  <xs:simpleType name="voices">
    <xs:annotation>
      <xs:documentation>Number of simultaneous voices. Either a numeric value in the range 1-32, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="voicesValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="voicesValue">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="32"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="max">
    <xs:annotation>
      <xs:documentation>Free-form string value, no format constraint.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="delay">
    <xs:annotation>
      <!-- NOTE: "delay" and "delayTime" are confusingly two separate, identically-
           behaving attribute types. This duplication is kept intentionally for
           backwards compatibility with existing WAXML documents - do not merge
           them without checking what depends on each name. -->
      <xs:documentation>Delay time in seconds. Shares the same range as delayTime (0-10) - kept as a separate type name only for backwards compatibility. Either a numeric value in the range 0-10, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="delayValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="delayValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  

  <!-- // AudioNodes -->

  <xs:simpleType name="frequency">
    <xs:annotation>
      <xs:documentation>Frequency in Hz. Either a numeric value in the range 0-22050, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="frequencyValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="frequencyValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="22050"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="detune">
    <xs:annotation>
      <xs:documentation>Detune amount in cents. Either a numeric value in the range -9600-9600, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="detuneValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="detuneValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-9600"/>
      <xs:maxInclusive value="9600"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Q">
    <xs:annotation>
      <xs:documentation>Filter resonance/quality factor. Either a numeric value in the range 0-100, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="QValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="QValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="100"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="delayTime">
    <xs:annotation>
      <xs:documentation>Delay time in seconds. Shares the same schema-level range as maxDelayTime (0-10), since delayTime should not exceed the node's own maxDelayTime. Note: this schema cannot enforce that delayTime stays below the actual maxDelayTime value set on the same node (that would require a cross-attribute constraint XSD 1.0 doesn't support) - if a document sets maxDelayTime lower than delayTime, that inconsistency is left for the runtime parser to handle. Either a numeric value in the range 0-10, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="delayTimeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="delayTimeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="maxDelayTime">
    <xs:annotation>
      <xs:documentation>Maximum delay time in seconds, set at node creation. Either a numeric value in the range 0-10, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="maxDelayTimeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="maxDelayTimeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  

  <!-- // compressor -->
  <xs:simpleType name="threshold">
    <xs:annotation>
      <xs:documentation>Compressor threshold in dB. Either a numeric value in the range -100-0, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="thresholdValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="thresholdValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-100"/>
      <xs:maxInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="knee">
    <xs:annotation>
      <xs:documentation>Compressor knee width in dB. Either a numeric value in the range 0-40, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="kneeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="kneeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="40"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="ratio">
    <xs:annotation>
      <xs:documentation>Compressor ratio. Either a numeric value in the range 1-20, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="ratioValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="ratioValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="20"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="attack">
    <xs:annotation>
      <xs:documentation>Compressor attack time in seconds. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="attackValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="attackValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="release">
    <xs:annotation>
      <xs:documentation>Compressor release time in seconds. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="releaseValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="releaseValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- // AudioBufferSourceNode -->
  
  <xs:simpleType name="playbackRate">
    <xs:annotation>
      <xs:documentation>Playback rate multiplier (1 = normal speed, negative = reverse). Either a numeric value in the range -2-2, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="playbackRateValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="playbackRateValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-2"/>
      <xs:maxInclusive value="2"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="loopStart">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  
  <xs:simpleType name="loopEnd">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <!-- // waxml -->
  
  <xs:simpleType name="transitionTime">
    <xs:annotation>
      <xs:documentation>Transition time in milliseconds. Either a numeric value in the range 0-2000, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="transitionTimeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="transitionTimeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="2000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ADSR">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <!-- // parameter mapping -->

  <xs:simpleType name="level">
    <xs:annotation>
      <xs:documentation>Signal level. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="levelValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="levelValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="range">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="curve">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="follow">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="mapin">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="mapout">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="times">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="values">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="channel">
    <xs:annotation>
      <xs:documentation>Audio channel number. Either a numeric value in the range 1-16, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="channelValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="channelValue">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="16"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="dynamictimes">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="dynamicvalues">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="targetvariables">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="convert">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="steps">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="value">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="default">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="pan">
    <xs:annotation>
      <xs:documentation>Stereo panning position (-1 = full left, 1 = full right). Either a numeric value in the range -1-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="panValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="panValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-1"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fadeTime">
    <xs:annotation>
      <!-- Consolidated from the former "iMusicFadeTime" (renamed here to just
           "fadeTime" - the "iMusic" prefix was only ever needed to avoid a
           name collision during the schema merge, not a meaningful distinction). -->
      <xs:documentation>The time used for crossfades when this object (often layers) is replaced by another. Default unit is set to 'ms'. If set to '0', the audio file will always play its full length and might cause layers of files playing. Either a numeric value in the range 0-500, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="fadeTimeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="fadeTimeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="500"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="loopLength">
    <xs:annotation>
      <!-- Consolidated from the former "iMusicLoopLength" (renamed here to just
           "loopLength" - the "iMusic" prefix was only ever needed to avoid a
           name collision during the schema merge, not a meaningful distinction). -->
      <xs:documentation>Loop length specified by a musical meter: 'bar', 'beat', nr of bars, 4/4, 3/4, 6/8, 5/8 etc or 'off' (for no loop).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="off|bar|beat|\d+|\d+(\.\d+)?\/\d+|-?\d+(\.\d+)?(ms|s)"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="coneInnerAngle">
    <xs:annotation>
      <xs:documentation>Inner angle of the sound cone in degrees. Either a numeric value in the range 0-360, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="coneInnerAngleValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="coneInnerAngleValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="360"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="coneOuterAngle">
    <xs:annotation>
      <xs:documentation>Outer angle of the sound cone in degrees. Either a numeric value in the range 0-360, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="coneOuterAngleValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="coneOuterAngleValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="360"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="coneOuterGain">
    <xs:annotation>
      <xs:documentation>Gain applied outside the outer cone angle. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="coneOuterGainValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="coneOuterGainValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="distanceModel">
    <xs:annotation>
      <xs:documentation>How the sound's volume falls off with distance. Either one of the standard Web Audio API values (linear, inverse, exponential), or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="distanceModelEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="distanceModelEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="inverse"/>
      <xs:enumeration value="exponential"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="maxDistance">
    <xs:annotation>
      <xs:documentation>Maximum distance for spatial audio falloff. Either a numeric value in the range 0-10, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="maxDistanceValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="maxDistanceValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="orientationX">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="orientationY">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="orientationZ">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="panningModel">
    <xs:annotation>
      <xs:documentation>Spatialization algorithm used for panning. Either one of the standard Web Audio API values (equalpower, HRTF), or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="panningModelEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="panningModelEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="equalpower"/>
      <xs:enumeration value="HRTF"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="positionX">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="positionY">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="positionZ">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="refDistance">
    <xs:annotation>
      <xs:documentation>Reference distance for spatial audio falloff. Either a numeric value in the range 0-10, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="refDistanceValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="refDistanceValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="rolloffFactor">
    <xs:annotation>
      <xs:documentation>How quickly volume falls off with distance. Either a numeric value in the range 0-10, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="rolloffFactorValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="rolloffFactorValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="timeUnit">
    <xs:annotation>
      <xs:documentation>Unit used to interpret time-based values on this element. Proposed values (please confirm/adjust): ms, s, samples. Either one of these, or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="timeUnitEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="timeUnitEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ms"/>
      <xs:enumeration value="s"/>
      <xs:enumeration value="samples"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="oversample">
    <xs:annotation>
      <xs:documentation>Oversampling used by a WaveShaperNode to reduce aliasing distortion, per the Web Audio API spec. Either one of these standard values, or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="oversampleEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="oversampleEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="2x"/>
      <xs:enumeration value="4x"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="crossFade">
    <xs:annotation>
      <xs:documentation>Crossfade amount. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="crossFadeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="crossFadeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>


	<!-- // Ambient Audio / Granular -->
  <xs:simpleType name="randomPosition">
    <xs:annotation>
      <xs:documentation>Amount of random variation applied to playback position. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="randomPositionValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="randomPositionValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="randomDuration">
    <xs:annotation>
      <xs:documentation>Amount of random variation applied to duration. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="randomDurationValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="randomDurationValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="randomDetune">
    <xs:annotation>
      <xs:documentation>Amount of random variation applied to detune. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="randomDetuneValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="randomDetuneValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="frameRate">
    <xs:annotation>
      <xs:documentation>Frame rate for GUI/animation updates. Either a numeric value in the range 4-120, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="frameRateValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="frameRateValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="4"/>
      <xs:maxInclusive value="120"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fallOffRatio">
    <xs:annotation>
      <xs:documentation>Ratio controlling falloff behaviour. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="fallOffRatioValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="fallOffRatioValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="smoothDerivative">
    <xs:annotation>
      <xs:documentation>Smoothing factor for the derivative/rate of change. Either a numeric value in the range 0-5, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="smoothDerivativeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="smoothDerivativeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="5"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ioSelector">
    <xs:annotation>
      <xs:documentation>Used by both "input" and "output" to specify a routing target. Either a CSS selector referring to another element in this WAXML document, or a JS-style string-concatenation expression involving one or more variables (e.g. "$busId", or '"#" + $trackId + "-out"'). Note: CSS-selector-shaped values are only checked against a permissive character set here, not validated as a fully correct CSS selector - and the concatenation-expression form is checked for shape only (balanced quotes/operators are a runtime concern, same as mathExpression's parentheses).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="ioSelectorCss ioSelectorExpression"/>
  </xs:simpleType>

  <xs:simpleType name="ioSelectorCss">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-zA-Z0-9_#.,:;&gt;+~*()='&quot;\-\[\] ]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ioSelectorExpression">
    <xs:restriction base="xs:string">
      <xs:pattern value="((&quot;[^&quot;]*&quot;|'[^']*'|\$[a-zA-Z_][a-zA-Z0-9_]*)\s*\+\s*)*\$[a-zA-Z_][a-zA-Z0-9_]*(\s*\+\s*(&quot;[^&quot;]*&quot;|'[^']*'|\$[a-zA-Z_][a-zA-Z0-9_]*))*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="outputBus">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="id">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="class">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="label">
    <xs:annotation>
      <xs:documentation>A human-readable label for display in a graphical interface. Distinct from "id" (used for programmatic reference/selectors) and "class" (used for styling/grouping) - this is purely for showing the user a friendly name.</xs:documentation>
      <xs:documentation>SCHEMA-WIDE CONVENTION: every element in this schema is expected to accept a "label" attribute - native Web Audio API nodes (via commonNodeAttributes), WAXML's own waxml-group elements (via the "waxml" attributeGroup), and every Composition-side element (Composition, Section, Layer, Segment, Stinger, Option, Command). Any new element added to this schema in the future should also get a "label" attribute, for consistency.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="name">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="src">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="href">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="controls">
    <xs:annotation>
      <xs:documentation></xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="oscillatorType">
    <xs:annotation>
      <xs:documentation>The shape of the waveform produced by an OscillatorNode, per the Web Audio API spec. "custom" is normally set automatically via setPeriodicWave() rather than specified manually, but is included as a valid value. Either one of these standard values, or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="oscillatorTypeEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="oscillatorTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sine"/>
      <xs:enumeration value="square"/>
      <xs:enumeration value="sawtooth"/>
      <xs:enumeration value="triangle"/>
      <xs:enumeration value="custom"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="biquadFilterType">
    <xs:annotation>
      <xs:documentation>The kind of filtering algorithm a BiquadFilterNode implements, per the Web Audio API spec. Either one of these standard values, or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="biquadFilterTypeEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="biquadFilterTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="lowpass"/>
      <xs:enumeration value="highpass"/>
      <xs:enumeration value="bandpass"/>
      <xs:enumeration value="lowshelf"/>
      <xs:enumeration value="highshelf"/>
      <xs:enumeration value="peaking"/>
      <xs:enumeration value="notch"/>
      <xs:enumeration value="allpass"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="selectIndex">
    <xs:annotation>
      <xs:documentation>Zero-based index selecting one of a Mixer's inputs. Upper bound is dynamic (number of child elements minus one) and not enforced by this schema. Either a non-negative integer, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="selectIndexValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="selectIndexValue">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="mix">
    <xs:annotation>
      <xs:documentation>Used as Mixer's "solo" attribute (was named "mix" before): a continuous channel-select position across a Mixer's children - 0 selects the first child, 1 the last, evenly spaced values in between select/blend the ones between. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="mixValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="mixValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="crossFadeRange">
    <xs:annotation>
      <xs:documentation>Used as Mixer's "blend" attribute (was named "crossFadeRange" before): how much a Mixer crossfades between two adjacent children when "solo" lands between them, rather than exactly on one. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="crossFadeRangeValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="crossFadeRangeValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="peak">
    <xs:annotation>
      <xs:documentation>Peak level. Either a numeric value in the range 0-1, or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="peakValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="peakValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="commandType">
    <xs:annotation>
      <xs:documentation>A command can trig or set a variable to a value. Either one of these standard values (trig, set), or a free-form string for forward compatibility.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="commandTypeEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="commandTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="trig"/>
      <xs:enumeration value="set"/>
      <xs:enumeration value="stop"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="bus">
    <xs:annotation>
      <xs:documentation>Bus output for Send elements. Normal CSS-selector that matches the ID or ClassName of target element.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  



  <!-- ============================================================= -->

  <!-- Composition (formerly iMusic) types                           -->

  <!-- Renamed to avoid collisions with identically-named waxml      -->

  <!-- types above. Validation rules (patterns, base types) are      -->

  <!-- preserved exactly as in the source schema.                    -->

  <!-- ============================================================= -->

  <!-- Types -->

  <xs:simpleType name="tempo">
    <xs:annotation>
      <xs:documentation>Beats per minute. Note: it always relates to the beat specified with timeSign. Either a numeric value (range TBD - min/max not yet specified), or a mathematical expression (see mathExpression).</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="tempoValue mathExpression"/>
  </xs:simpleType>

  <xs:simpleType name="tempoValue">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="40"/>
      <xs:maxInclusive value="250"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="quantize">
    <xs:annotation>
      <xs:documentation>Musical value for synchronizing objects: 'bar', 'beat', nr of bars, 4/4, 3/4, 6/8, 5/8 etc</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="off|bar|beat|\d+|\d+(\.\d+)?\/\d+|-?\d+(\.\d+)?(ms|s)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="length">
    <xs:annotation>
      <xs:documentation>Musical length: 'bar', 'beat', nr of bars, 4/4, 3/4, 6/8, 5/8 etc</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="bar|beat|-?\d+|-?\d+(\.\d+)?\/\d+|-?\d+(\.\d+)?(ms|s)"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="meter">
    <xs:annotation>
      <xs:documentation>Musical meter: 4/4, 3/4, 6/8, 5/8 etc</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+(\.\d+)?\/\d+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="position">
    <xs:annotation>
      <xs:documentation>Position: bar, beat, bar-number, bar.beat or bar.beat.division (i.e. 4.4.75) etc</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="bar|beat|-?\d+|-?\d+[.]\d+|-?\d+[.]\d+[.]\d+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="active">
    <xs:annotation>
      <xs:documentation>Controls the likeliness for each Segment on a Layer to playback. If set to '1', they will always play. If set to '0' they will never play. If set to '0.5', there will a 50% chance of the Segments to play. If there are no Segments on the Layer the setting will apply to the whole Layer. The value can also be any variable expression like '$intensity = 1', '$intensity = 1...3, 5...6' or similar.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d+\.?\d+|$?([a-zA-Z])+|$?([a-zA-Z])+\,([ ])*([a-zA-Z])+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="filter">
    <xs:annotation>
      <xs:documentation>Controls the state of a track depending on one or multiple variables. 
        Value is given as an expression like filter='intensity=1' which causes this object to 
        play only when the variable intensity is equal to 1. It is possible to use multiple values
        ranges of values, strings and multiple expressions separated with semi colon.
        (i.e. filter="intensity=1,2,5; mood=happy; room=2...5")</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="loopActive">
    <xs:annotation>
      <xs:documentation>Controls the likeliness for the the track to playback each loop. If set to '1' it will always play. If set to '0' it will never play. If set to '0.5', there will a 50% chance that it plays. The value can also be any variable expression like '$intensity = 1', '$intensity = 1...3, 5...6' or similar.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d+\.?\d+|$?([a-zA-Z])+|$?([a-zA-Z])+\,([ ])*([a-zA-Z])+"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="audioPath">
    <xs:annotation>
      <xs:documentation>Relative or absolute path to the audio files used in elements inside this element.</xs:documentation>
      <xs:documentation>It makes it unnecessary to specify the path for each audio file. Default is 'audio'.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="((http|https)*://)*([a-zA-Z0-9_\-/])+"></xs:pattern>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fileName">
    <xs:annotation>
      <xs:documentation>File name. The directory can be omitted if 'audioPath' set on a parent element. The file extension (mp3, wav, ogg or m4a) can be omitted if 'suffix' is set on a parent element.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="([a-zA-Z0-9_\-/])+|([a-zA-Z0-9_\-/])+\.mp3|([a-zA-Z0-9_\-/])+\.wav|([a-zA-Z0-9_\-/])+\.ogg|([a-zA-Z0-9_\-/])+\.m4a"/>
    </xs:restriction>
  </xs:simpleType>


  <xs:simpleType name="suffix">
    <xs:annotation>
      <xs:documentation>File extension: 'mp3', 'wav', 'ogg' or 'm4a'. Strictly enumerated (no free-form fallback) - this controls which audio file types are accepted, not just a GUI suggestion.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="mp3"/>
      <xs:enumeration value="wav"/>
      <xs:enumeration value="ogg"/>
      <xs:enumeration value="m4a"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="retrigMode">
    <xs:annotation>
      <xs:documentation>Controls how the different options are selected: 'shuffle', 'next' or 'other'. Used by both the "retrig" and "blockRetrig" attributes, which are distinct settings sharing the same set of accepted values.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="retrigModeEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="retrigModeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="shuffle"/>
      <xs:enumeration value="next"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="iMusicClass">
    <xs:annotation>
      <xs:documentation>CSS class name for selecting and triggering from iMusic javascript API.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="iMusicId">
    <xs:annotation>
      <xs:documentation>CSS ID for selecting and triggering from iMusic javascript API.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>












  <xs:simpleType name="voice">
    <xs:annotation>
      <xs:documentation>The output of this object is handled as a monophonic voice with all other objects tagged with the same instrument name. This means i.e. that triggering a Stinger temporarily mutes a Layer if they are set to the same voice. The feature is useful for having Stingers altering the content of an instrument rather than adding a new instrument.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="iMusicTimes">
    <xs:annotation>
      <xs:documentation>A comma separated list of time positions. Use note values or seconds. ''now'' means it will trigger directly when the Layer or the Stinger is triggered</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="iMusicValues">
    <xs:annotation>
      <xs:documentation>A comma separated list of values used with matching time value to shape an envelope. First value is the start value.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="target">
    <xs:annotation>
      <xs:documentation>Target parameter in WebAudioXML</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="ENVdefault">
    <xs:annotation>
      <xs:documentation>Default value for an envelope</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>


  <xs:simpleType name="iMusicConvert">
    <xs:annotation>
      <xs:documentation>Formula for converting the value. Either one of the named presets (MIDI-&gt;frequency, dB-&gt;power), or a free-form mathematical expression using 'x' as the placeholder for the input value (e.g. 'Math.pow(x, 2)'). Note: this 'x'-based expression syntax is separate from mathExpression's '$variable' syntax used elsewhere in this schema - they are not interchangeable.</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="iMusicConvertEnum xs:string"/>
  </xs:simpleType>

  <xs:simpleType name="iMusicConvertEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="MIDI-&gt;frequency"/>
      <xs:enumeration value="dB-&gt;power"/>
    </xs:restriction>
  </xs:simpleType>




  <!-- Element Groups -->

  <xs:group name="snapshot">
    <xs:choice>
      <xs:element name="Command" type="commandContentType"/>
    </xs:choice>
  </xs:group>


  <xs:group name="waxml">
    <xs:choice>


      <!-- Native elements -->
      <xs:element name="AudioBufferSourceNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributesNoInput"/>
          <xs:attribute name="transitionTime" type="transitionTime"/>
          <xs:attribute name="src" type="src"/>
          <xs:attribute name="detune" type="detune"/>
          <xs:attribute name="loop" type="loop"/>
          <xs:attribute name="loopEnd" type="loopEnd"/>
          <xs:attribute name="loopStart" type="loopStart"/>
          <xs:attribute name="playbackRate" type="playbackRate"/>
        </xs:complexType>
      </xs:element>

      <xs:element name="AudioWorkletNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributes"/>
          <xs:attribute name="src" type="src"/>
        </xs:complexType>
      </xs:element>

      <xs:element name="DelayNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributes"/>
          <xs:attribute name="transitionTime" type="transitionTime"/>
          <xs:attribute name="delayTime" type="delayTime"/>
          <xs:attribute name="maxDelayTime" type="maxDelayTime"/>
        </xs:complexType>
      </xs:element>

      <xs:element name="MediaStreamAudioSourceNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributesNoInput"/>
        </xs:complexType>
      </xs:element>

      <xs:element name="PannerNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributes"/>
          <xs:attribute name="transitionTime" type="transitionTime"/>
          <xs:attribute name="panningModel" type="panningModel"/>
          <xs:attribute name="distanceModel" type="distanceModel"/>
          <xs:attribute name="positionX" type="positionX"/>
          <xs:attribute name="positionY" type="positionY"/>
          <xs:attribute name="positionZ" type="positionZ"/>
          <xs:attribute name="orientationX" type="orientationX"/>
          <xs:attribute name="orientationY" type="orientationY"/>
          <xs:attribute name="orientationZ" type="orientationZ"/>
          <xs:attribute name="refDistance" type="refDistance"/>
          <xs:attribute name="maxDistance" type="maxDistance"/>
          <xs:attribute name="rolloffFactor" type="rolloffFactor"/>
          <xs:attribute name="coneInnerAngle" type="coneInnerAngle"/>
          <xs:attribute name="coneOuterAngle" type="coneOuterAngle"/>
          <xs:attribute name="coneOuterGain" type="coneOuterGain"/>
        </xs:complexType>
      </xs:element>

      <xs:element name="WaveShaperNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributes"/>
          <xs:attribute name="curve" type="curve"/>
          <xs:attribute name="oversample" type="oversample"/>
        </xs:complexType>
      </xs:element>


      <xs:element name="OscillatorNode">
        <xs:complexType>
          <xs:attributeGroup ref="commonNodeAttributesNoInput"/>
          <xs:attribute name="transitionTime" type="transitionTime"/>
          <xs:attribute name="frequency" type="frequency"/>
          <xs:attribute name="detune" type="detune"/>
          <xs:attribute name="type" type="oscillatorType"/>
        </xs:complexType>
      </xs:element>

      <xs:element name="GainNode">
        <xs:complexType>
