  <!-- Elements -->


  <!-- ============================================================= -->
  <!-- Composition (formerly iMusic) content model                     -->
  <!--                                                                 -->
  <!-- All elements below are LOCAL declarations (not global), each    -->
  <!-- using a shared named complexType. This is the only way in XSD   -->
  <!-- 1.0 to guarantee an element can ONLY appear in specific parent  -->
  <!-- contexts and can never be used as a document root:              -->
  <!--                                                                 -->
  <!--   Audio        - the only valid document root                  -->
  <!--   Composition  - only directly inside Audio, at most once       -->
  <!--   section      - only directly inside Composition               -->
  <!--   layer        - only inside section                            -->
  <!--   segment      - only inside layer                              -->
  <!--   option       - only inside layer, segment, or stinger           -->
  <!--   command      - only inside stinger                              -->
  <!--   stinger      - only inside Composition or section              -->
  <!--   envelope     - commented out for now (see bottom of section)  -->
  <!--                                                                 -->
  <!-- (segment was renamed from "region"; stinger unifies what were   -->
  <!-- previously two separate elements, "motif" and "leadin" - they   -->
  <!-- were functionally identical, just used with different default   -->
  <!-- quantize values. leadin was also previously valid inside layer  -->
  <!-- (then named "track"); that placement is gone now that stinger   -->
  <!-- is restricted to Composition/section only)                      -->
  <!-- ============================================================= -->

  <xs:complexType name="commandContentType">
    <xs:attribute name="pos" type="position"/>
    <xs:attribute name="type" type="command_type"/>
    <xs:attribute name="selector" type="xs:string"/>
    <xs:attribute name="variable" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="optionContentType">
    <!-- <xs:element name="envelope" .../> was allowed here; commented out for now -->
    <xs:attribute name="src" type="fileName"/>
    <xs:attribute name="pos" type="position"/>
    <xs:attribute name="length" type="length"/>
    <xs:attribute name="delay" type="length"/>
    <xs:attribute name="upbeat" type="length"/>
    <xs:attribute name="voice" type="voice"/>
  </xs:complexType>

  <xs:complexType name="segmentContentType">
    <xs:sequence>
      <xs:element name="option" type="optionContentType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="pos" type="position"/>
    <xs:attribute name="upbeat" type="length"/>
    <xs:attribute name="src" type="fileName"/>
    <xs:attribute name="length" type="length"/>
    <xs:attribute name="delay" type="length"/>
  </xs:complexType>

  <xs:complexType name="stingerContentType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="option" type="optionContentType"/>
      <!-- <xs:element name="envelope" .../> was allowed here; commented out for now -->
      <xs:element name="command" type="commandContentType"/>
    </xs:choice>
    <xs:attribute name="class" type="xs:string"/>
    <xs:attribute name="id" type="xs:string"/>
    <xs:attribute name="voice" type="voice"/>
    <xs:attribute name="output" type="iMusicOutput"/>
    <xs:attribute name="src" type="fileName"/>
    <xs:attribute name="quantize" type="quantize"/>
    <xs:attribute name="changeOnNext" type="length"/>
    <xs:attribute name="upbeat" type="length"/>
    <xs:attribute name="length" type="length"/>
    <xs:attribute name="pos" type="position"/>
    <xs:attribute name="delay" type="length"/>
    <xs:attribute name="active" type="active"/>
    <xs:attribute name="filter" type="filter"/>
    <xs:attribute name="retrig" type="retrig"/>
    <xs:attribute name="blockRetrig" type="blockRetrig"/>
    <xs:attribute name="fadeTime" type="fadeTime"/>
  </xs:complexType>

  <xs:complexType name="layerContentType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="segment" type="segmentContentType"/>
      <xs:element name="option" type="optionContentType"/>
    </xs:choice>
    <xs:attribute name="class" type="iMusicClass"/>
    <xs:attribute name="id" type="iMusicId"/>
    <xs:attribute name="voice" type="voice"/>
    <xs:attribute name="output" type="iMusicOutput"/>
    <xs:attribute name="audioPath" type="audioPath"/>
    <xs:attribute name="suffix" type="suffix"/>
    <xs:attribute name="src" type="fileName"/>
    <xs:attribute name="changeOnNext" type="length"/>
    <xs:attribute name="fadeTime" type="fadeTime"/>
    <xs:attribute name="loopLength" type="loopLength"/>
    <xs:attribute name="partLength" type="length"/>
    <xs:attribute name="upbeat" type="length"/>
    <xs:attribute name="active" type="active"/>
    <xs:attribute name="filter" type="filter"/>
    <xs:attribute name="loopActive" type="loopActive"/>
  </xs:complexType>

  <xs:complexType name="sectionContentType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="layer" type="layerContentType"/>
      <xs:element name="stinger" type="stingerContentType"/>
    </xs:choice>
    <xs:attribute name="class" type="iMusicClass"/>
    <xs:attribute name="id" type="iMusicId"/>
    <xs:attribute name="audioPath" type="audioPath"/>
    <xs:attribute name="tempo" type="tempo"/>
    <xs:attribute name="timeSign" type="meter"/>
    <xs:attribute name="suffix" type="suffix"/>
    <xs:attribute name="changeOnNext" type="length"/>
    <xs:attribute name="fadeTime" type="fadeTime"/>
    <xs:attribute name="loopLength" type="length"/>
    <xs:attribute name="length" type="length"/>
    <xs:attribute name="src" type="fileName"/>
  </xs:complexType>

  <xs:complexType name="CompositionContentType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="section" type="sectionContentType"/>
      <xs:element name="stinger" type="stingerContentType"/>
    </xs:choice>
    <xs:attribute name="version" type="iMusicVersion"/>
    <xs:attribute name="audioPath" type="audioPath"/>
    <xs:attribute name="tempo" type="tempo"/>
    <xs:attribute name="timeSign" type="meter"/>
    <xs:attribute name="suffix" type="suffix"/>
    <xs:attribute name="showGUI" type="showGUI"/>
    <xs:attribute name="changeOnNext" type="length"/>
    <xs:attribute name="fadeTime" type="fadeTime"/>
    <xs:attribute name="loopLength" type="length"/>
  </xs:complexType>

  <!--
  Commented out for now, per request. To reinstate: uncomment this
  complexType and add `<xs:element name="envelope" type="envelopeContentType"/>`
  back into optionContentType and stingerContentType above.

  <xs:complexType name="envelopeContentType">
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="times" type="iMusicTimes"/>
    <xs:attribute name="values" type="iMusicValues"/>
    <xs:attribute name="target" type="target"/>
    <xs:attribute name="default" type="ENVdefault"/>
    <xs:attribute name="convert" type="iMusicConvert"/>
  </xs:complexType>
  -->

  <xs:element name="waxml">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="waxml" minOccurs="1" maxOccurs="unbounded"/>
        <xs:element name="Composition" type="CompositionContentType" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="waxml"/>
    </xs:complexType>
  </xs:element>


</xs:schema>
