  <!-- ============================================================= -->
  <!-- Composition (formerly iMusic) content model                     -->
  <!--                                                                 -->
  <!-- All elements below are LOCAL declarations (not global), each    -->
  <!-- using a shared named complexType. This is the only way in XSD   -->
  <!-- 1.0 to guarantee an element can ONLY appear in specific parent  -->
  <!-- contexts and can never be used as a document root:              -->
  <!--                                                                 -->
  <!--   Audio        - the only valid document root                  -->
  <!--   Composition  - only directly inside Audio, at most once       -->
  <!--   Section      - only directly inside Composition               -->
  <!--   Layer        - only inside Section                            -->
  <!--   Segment      - only inside Layer                              -->
  <!--   Option       - only inside Layer, Segment, or Stinger           -->
  <!--   Command      - inside Option, Segment, Stinger, Layer, or        -->
  <!--                   Composition, AND as a repeatable root-level      -->
  <!--                   sibling of Audio's own top-level content (see    -->
  <!--                   the root element's own complexType below) - not  -->
  <!--                   just Stinger, despite this list's old wording    -->
  <!--                   (root-level Command is how the player bar's      -->
  <!--                   trigger-shortcut buttons are defined)            -->
  <!--   Stinger      - only inside Composition or Section              -->
  <!--   envelope     - commented out for now (see bottom of section)  -->
  <!--                                                                 -->
  <!-- (Segment was renamed from "region"; Stinger unifies what were   -->
  <!-- previously two separate elements, "motif" and "leadin" - they   -->
  <!-- were functionally identical, just used with different default   -->
  <!-- quantize values. leadin was also previously valid inside Layer  -->
  <!-- (then named "track"); that placement is gone now that Stinger   -->
  <!-- is restricted to Composition/Section only)                      -->
  <!-- ============================================================= -->

  <xs:complexType name="parameterContentType">
    <xs:attribute name="label" type="label"/>
    <xs:attribute name="name" type="name"/>
