    <xs:attribute name="showGUI" type="showGUI"/>
    <xs:attribute name="changeOnNext" type="length"/>
    <xs:attribute name="fadeTime" type="iMusicFadeTime"/>
    <xs:attribute name="loopLength" type="length"/>
  </xs:complexType>

  <!--
  Commented out for now, per request. To reinstate: uncomment this
  complexType and add `<xs:element name="envelope" type="envelopeContentType"/>`
  back into optionContentType, motifContentType, and leadinContentType above.

  <xs:complexType name="envelopeContentType">
