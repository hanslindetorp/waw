    </xs:choice>
    <xs:attribute name="version" type="iMusicVersion"/>
    <xs:attribute name="audioPath" type="audioPath"/>
    <xs:attribute name="tempo" type="tempo"/>
    <xs:attribute name="timeSign" type="meter"/>
